      "source": [
        "# Leap Year Checker\n",
        "\n",
        "year = int(input(\"Enter a year: \"))\n",
        "\n",
        "if year % 400 == 0:\n",
        "    print(\"Leap Year\")\n",
        "elif year % 100 == 0:\n",
        "    print(\"Not a Leap Year\")\n",
        "elif year % 4 == 0:\n",
        "    print(\"Leap Year\")\n",
        "else:\n",
        "    print(\"Not a Leap Year\")"
      ]
    }
  ]
}