        "# Dictionary Program\n",
        "\n",
        "student = {\n",
        "    \"name\": \"Ravi\",\n",
        "    \"age\": 20,\n",
        "    \"course\": \"B.Tech\"\n",
        "}\n",
        "\n",
        "print(\"Name:\", student[\"name\"])\n",
        "print(\"Age:\", student[\"age\"])\n",
        "print(\"Course:\", student[\"course\"])"
