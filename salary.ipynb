      "source": [
        "# Salary Calculator\n",
        "\n",
        "basic_salary = float(input(\"Enter basic salary: \"))\n",
        "\n",
        "hra = basic_salary * 0.20\n",
        "da = basic_salary * 0.10\n",
        "\n",
        "gross_salary = basic_salary + hra + da\n",
        "\n",
        "print(\"HRA:\", hra)\n",
        "print(\"DA:\", da)\n",
        "print(\"Gross Salary:\", gross_salary)"
      ]
    }
  ]
