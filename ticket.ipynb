        "# Movie Ticket Booking\n",
        "\n",
        "movie = input(\"Enter movie name: \")\n",
        "tickets = int(input(\"Enter number of tickets: \"))\n",
        "\n",
        "price = 150\n",
        "\n",
        "total = tickets * price\n",
        "\n",
        "print(\"\\nMovie:\", movie)\n",
        "print(\"Tickets:\", tickets)\n",
        "print(\"Ticket Price: ₹\", price)\n",
        "print(\"Total Amount: ₹\", total)"
